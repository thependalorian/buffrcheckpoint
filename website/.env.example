# Section 11.8.8 sitemap/robots + Section 4a.7 Capability Status Badge

# --- Local development (default) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Production (buffrcheckpoint.com — set in Vercel env panel) ---
# NEXT_PUBLIC_SITE_URL=https://buffrcheckpoint.com
# NEXT_PUBLIC_API_URL=https://api.buffrcheckpoint.com

# Observability (§11.8.5) — leave blank to no-op locally
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
#
# Verify after DSN is set: trigger a test exception from a Route Handler or
# use the Sentry wizard (npx @sentry/wizard@latest -i nextjs), then check Issues.
# Prefer interactive wizard when creating projects: npx @sentry/wizard@latest -i nextjs

# Primary contact address shown to visitors. Defaults to team@buffranalytics.com.
# NEXT_PUBLIC_CONTACT_EMAIL=team@buffranalytics.com
