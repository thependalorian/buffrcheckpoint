# Buffr Checkpoint social content system. Copy to .env; never commit .env.

# Neon connection string (direct or pooled). channel_binding is stripped automatically.
SOCIAL_DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Provider keys (Pydantic AI reads these directly)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=            # only if you add openai:* models below

# Model roster. Writers are ordered cheapest -> strongest (used for escalation).
SOCIAL_PLANNER_MODEL=anthropic:claude-sonnet-5-5
SOCIAL_WRITER_MODELS=anthropic:claude-haiku-4-5-20251001,anthropic:claude-sonnet-5-5,anthropic:claude-opus-5-5
SOCIAL_CRITIC_MODELS=anthropic:claude-haiku-4-5-20251001,anthropic:claude-sonnet-5-5

# USD per million tokens [input, output]. Confirm at https://claude.com/pricing.
# Required for any model not in config.DEFAULT_PRICES.
# MODEL_PRICES_JSON={"openai:gpt-5-mini": [0.25, 2.0]}

SOCIAL_WEEKLY_BUDGET_USD=3.00
SOCIAL_MAX_REVISIONS=2
SOCIAL_EXPLORATION_RATE=0.15
SOCIAL_CONCURRENCY=3
SOCIAL_OUTPUT_DIR=out

# Images (render command). Illustrator: cheapest first, one stronger retry.
SOCIAL_ILLUSTRATOR_MODELS=anthropic:claude-haiku-4-5-20251001,anthropic:claude-sonnet-5-5
SOCIAL_RENDER_BUDGET_USD=1.00
