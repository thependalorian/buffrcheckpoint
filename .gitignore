# Buffr Checkpoint
#
# Monorepo layout:
# - backend/      NestJS API (Railway)
# - admin/        Customer admin (Vercel)
# - ops-console/  Platform ops console (Vercel)
# - website/      Marketing site (Vercel)
# - kiosk/        Android kiosk app
# - shared/       Shared TypeScript package
#
# Product/engineering source of truth: buffrcheckpoint.md

node_modules/
dist/
build/
out/
.next/
.turbo/
.vercel/
coverage/
*.tsbuildinfo

# Secrets and local env (keep *.example)
.env
.env.*
!.env.example
!**/.env.example

# OS / editor
.DS_Store
*.pem
.idea/
.vscode/

# Local Claude / agent scratch (large PDFs, locks)
.claude/**/*.pdf
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Ad-hoc screenshots at repo root
/*.PNG
/*.png
/*.jpg
/*.jpeg

# Android / kiosk build outputs
kiosk/.gradle/
kiosk/**/build/
kiosk/**/*.apk
kiosk/**/*.aab
kiosk/local.properties

# Evidence / generated packs
**/generated-evidence-packs/

# Acceptance gate local marks / sign-offs (§17.4)
scripts/acceptance/state.json
scripts/acceptance/state.*.json

# CiMSO INNterchange proprietary package (NDA / Restricted) — keep notes, not the dump
docs/cimso-innterchange/INNterchange_Specifications_*/
docs/cimso-innterchange/*.7z
docs/cimso-innterchange/C-AGR-CND_*.pdf

# E2E screenshots may contain visitor PII
e2e-screenshots/

# Python (social_media_team)
.venv/
__pycache__/
.pytest_cache/

# Local artifact store output (ARTIFACT_STORE=local)
backend/generated-packages/
