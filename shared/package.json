{
  "name": "@buffrcheckpoint/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical cross-surface codes for Buffr Checkpoint (visit status, identity assurance, form rules).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./visit-status": {
      "types": "./dist/visit-status.d.ts",
      "default": "./dist/visit-status.js"
    },
    "./identity-assurance-level": {
      "types": "./dist/identity-assurance-level.d.ts",
      "default": "./dist/identity-assurance-level.js"
    },
    "./form-rules": {
      "types": "./dist/form-rules.d.ts",
      "default": "./dist/form-rules.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
