{
  "name": "buffrcheckpoint-backend",
  "version": "0.0.1",
  "description": "Buffr Checkpoint backend — NestJS modular monolith (buffrcheckpoint.md §13 and §14)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "biome format --write",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "db:generate": "drizzle-kit generate",
    "db:introspect": "drizzle-kit introspect",
    "db:studio": "drizzle-kit studio",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "audit:routes": "nest build && node scripts/audit-route-policy.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1140.0",
    "@neondatabase/serverless": "0.10.4",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/event-emitter": "12.0.0",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/throttler": "6.5.0",
    "@node-rs/argon2": "2.2.1",
    "@sentry/nestjs": "10.73.0",
    "@vercel/blob": "2.8.0",
    "bcryptjs": "2.4.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "dotenv": "16.6.1",
    "drizzle-orm": "0.45.2",
    "exceljs": "4.4.0",
    "helmet": "8.3.0",
    "jose": "5.10.0",
    "nodemailer": "10.0.12",
    "otplib": "12.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.3",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.1",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "6.0.3",
    "drizzle-kit": "0.31.11",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "15.5.2",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.14",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.ts": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "overrides": {
    "multer": "2.4.0",
    "tar": "7.5.20",
    "fast-xml-parser": "4.5.7",
    "proxy-addr": "2.0.8",
    "uuid": "11.1.1",
    "sharp": "0.35.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test/setup-env.ts"
    ]
  },
  "optionalDependencies": {
    "@gutenye/ocr-node": "1.4.9"
  }
}
