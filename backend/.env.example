# Buffr Checkpoint backend — Neon Postgres connection
# Copy to .env and fill in from `neonctl connection-string` or the Neon console
# (Project: buffr-checkpoint, id bold-cloud-47505421). Never commit .env.
#
# DEVELOPMENT/TESTING ONLY: this Neon project is provisioned in aws-us-west-2
# (United States), not Namibia. Synthetic data only — no real visitor PII may
# ever be written here. Before any production or pilot use, a Namibia-hosted
# infrastructure choice, the client's Namibia-based private cloud, or another
# reviewed-and-accepted hosting arrangement must be selected and evidenced
# (buffrcheckpoint.md Section 4a.7 / v0.4 hardening pass point 2). The public
# website must never claim "Data hosted in Namibia" while this connection
# string points at aws-us-west-2.
# Prefer least-privilege role `buffr_checkpoint_runtime` (SQL-created — NOT a
# Neon Console/API role, which joins neon_superuser and bypasses REVOKEs).
# See backend/db/migrations/0024_app_role_append_only_enforcement.sql.
DATABASE_URL=postgresql://buffr_checkpoint_runtime:<password>@<host>/neondb?channel_binding=require&sslmode=require

# Section 13.1's MFA/session control baseline — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<generate-a-real-random-secret-do-not-reuse-this-example>
PORT=3001

# Access tokens are signed with Ed25519 keys held in the database (auth_signing_key) and published at /.well-known/jwks.json.
# JWT_SECRET only verifies sessions issued before that change. Set JWT_LEGACY_HS256_UNTIL (ISO date) for the cutover window, then unset it.
# JWT_LEGACY_HS256_UNTIL=
# Access token life in seconds. Unset keeps a token for the whole session (8h admin, 2h ops). Set 900 once admin and ops refresh via
# POST /auth/refresh (standard SE-2).
# ACCESS_TOKEN_TTL_SECONDS=900

# Section 11.3/11.4.5a's phone/name/host-contact-reference keyed-hash
# matching (visitors.service.ts, hosts.service.ts). Each pepper should be a
# distinct random secret, not reused across columns.
PHONE_HASH_PEPPER=<generate-a-real-random-secret-do-not-reuse-this-example>
NAME_HASH_PEPPER=<generate-a-real-random-secret-do-not-reuse-this-example>
CONTACT_REFERENCE_HASH_PEPPER=<generate-a-real-random-secret-do-not-reuse-this-example>
QR_TOKEN_PEPPER=<generate-a-real-random-secret-do-not-reuse-this-example>

# --- Local development (default) ---
CORS_ORIGIN=http://localhost:3000,http://localhost:3002
PUBLIC_ASSET_BASE_URL=http://localhost:3000
PUBLIC_WEB_BASE_URL=http://localhost:3002
VISITOR_CHECKIN_BASE_URL=http://localhost:3002
PUBLIC_ADMIN_BASE_URL=http://localhost:3000

# Email verification + MFA (required for secure onboarding)
# EMAIL_VERIFICATION_PEPPER=<random hex>
# MFA_CHALLENGE_PEPPER=<random hex>
# MFA_SECRET_ENCRYPTION_KEY=<at least 32 random chars>
# RESEND_API_KEY=<from resend.com>
# Verified Resend sending domain: mail.buffrcheckpoint.com (Namecheap Advanced DNS)
# RESEND_MAIL_DOMAIN=mail.buffrcheckpoint.com
# RESEND_FROM_EMAIL=Buffr Checkpoint <onboarding@mail.buffrcheckpoint.com>
# CONTACT_OPS_EMAIL=hello@buffr.ai
# EMAIL_VERIFICATION_TTL_MS=86400000

# --- Production (buffrcheckpoint.com — set in host env panel, not committed) ---
# Include www — Vercel may serve www without redirecting to apex; missing www
# causes browser "Failed to fetch" on contact / check-in (CORS).
# CORS_ORIGIN=https://buffrcheckpoint.com,https://www.buffrcheckpoint.com,https://admin.buffrcheckpoint.com,https://ops.buffrcheckpoint.com
# PUBLIC_ASSET_BASE_URL=https://admin.buffrcheckpoint.com
# PUBLIC_WEB_BASE_URL=https://buffrcheckpoint.com
# VISITOR_CHECKIN_BASE_URL=https://buffrcheckpoint.com
# PUBLIC_ADMIN_BASE_URL=https://admin.buffrcheckpoint.com
# PUBLIC_OPS_BASE_URL=https://ops.buffrcheckpoint.com
# PUBLIC_WEBSITE_BASE_URL=https://buffrcheckpoint.com
# PUBLIC_BRAND_LOGO_URL=https://buffrcheckpoint.com/branding/logo-horizontal.png
# RESEND_API_KEY=<from resend.com>
# RESEND_MAIL_DOMAIN=mail.buffrcheckpoint.com
# RESEND_FROM_EMAIL=Buffr Checkpoint <onboarding@mail.buffrcheckpoint.com>
# CONTACT_OPS_EMAIL=hello@buffr.ai
# BILLING_LEGAL_NAME=Buffr Financial Services CC
# BILLING_ADDRESS=Windhoek, Namibia
# BILLING_BANK_NAME=
# BILLING_BANK_ACCOUNT_NAME=
# BILLING_BANK_ACCOUNT_NUMBER=
# BILLING_BANK_BRANCH_CODE=
# BILLING_VAT_NUMBER=
# BILLING_REGISTRATION_NUMBER=

# Personal-data envelope encryption (hosts/visitor contact fields).
# Required in production, at least 16 characters: with NODE_ENV=production a missing
# or short value makes encryption fail (no fallback). Outside production an insecure
# local-dev default applies. The same rule covers PHONE_HASH_PEPPER, NAME_HASH_PEPPER,
# CONTACT_REFERENCE_HASH_PEPPER, EMAIL_VERIFICATION_PEPPER and JWT_SECRET. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# LOCAL_DEV_DATA_KEY=<generate-a-real-random-secret-do-not-reuse-this-example>

# --- CiMSO INNterchange (hospitality PMS) — TCP client; multi-site ---
# Spec digest: docs/cimso-innterchange/NDA_PACKAGE_NOTES.md
# Prefer per-site rows on pms_integration_connections (admin Connect sheet):
#   tcp_host, tcp_port, tls_enabled, client_login_id, credentials_secret_ref, default_host_id
# Password = process.env[credentials_secret_ref], e.g.:
# CIMSO_SITE_DEMO_CLIENT_PASSWORD=
# Global fallbacks for local single-site only:
# CIMSO_INNTERCHANGE_HOST=
# CIMSO_INNTERCHANGE_PORT=
# CIMSO_INNTERCHANGE_TLS=true
# CIMSO_INNTERCHANGE_CLIENT_LOGIN_ID=
# CIMSO_INNTERCHANGE_CLIENT_PASSWORD=
# CIMSO_SITE_EXTERNAL_ID=
# CIMSO_ENABLED_INTERFACE_TYPES=1,3,4
# Do not use legacy CIMSO_INNTERCHANGE_BASE_URL / API_KEY (pre-package REST placeholders).

# Observability (§11.8.5) — leave blank to no-op locally / until DSNs are provisioned
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Artifact storage (evidence packs, KYB, billing POP, DSAR) ---
# Production primary (v0.29): Neon Object Storage on Frankfurt project
# falling-frog-15538162 / branch br-blue-frog-b1sgfw94 (aws-eu-central-1).
# ARTIFACT_STORE=neon_s3
# NEON_STORAGE_ENDPOINT=https://br-blue-frog-b1sgfw94.storage.c-5.eu-central-1.aws.neon.tech
# NEON_STORAGE_BUCKET=buffr-checkpoint-artifacts
# NEON_STORAGE_REGION=eu-central-1
# NEON_STORAGE_ACCESS_KEY_ID=
# NEON_STORAGE_SECRET_ACCESS_KEY=
# Temporary bridge / explicit degrade only (not permanent primary):
# ARTIFACT_STORE=vercel_blob
# BLOB_READ_WRITE_TOKEN=

# --- Neon AI Gateway (admin form suggest / translate — no visitor PII) ---
# FORM_AI_ENABLED=true
# NEON_AI_GATEWAY_BASE_URL=https://ai.<branch>.neon.tech/v1
# NEON_AI_GATEWAY_API_KEY=
# NEON_AI_GATEWAY_MODEL=openai/gpt-4.1-mini

# --- Analytics ETL (buffrcheckpoint.md 11.1b) ---
# ANALYTICS_ETL_ENABLED=true
# ANALYTICS_ETL_INTERVAL_MS=3600000
# ANALYTICS_ETL_LOOKBACK_DAYS=3
# ANALYTICS_TIMEZONE=Africa/Windhoek
# ANALYTICS_MIN_CELL=5

# --- Retention disposition (buffrcheckpoint.md 11.9.0a, migration 0043) ---
# OFF unless set to "true": the worker soft-deletes expired visits and
# irreversibly shreds personal data. Review a dry run first:
# POST /platform/retention/runs with {"dryRun": true}.
# RETENTION_DISPOSITION_ENABLED=false
# RETENTION_DISPOSITION_INTERVAL_MS=86400000

# --- Card payments: Adumo Online Virtual (buffrcheckpoint.md 11.1c) ---
# Card payments stay off until all three of the first values are set.
# Get them from the Adumo Merchant Portal; never commit real values.
# ADUMO_MERCHANT_ID=
# ADUMO_APPLICATION_ID=
# ADUMO_JWT_SECRET=
# ADUMO_BASE_URL=https://apiv3.adumoonline.com        # staging: https://staging-apiv3.adumoonline.com
# ADUMO_NOTIFY_URL=https://api.buffrcheckpoint.com/public/payments/adumo/result

# Scheduled reports worker (ops daily summary, weekly digest, monthly pack). Opt-in.
SCHEDULED_REPORTS_ENABLED=false
SCHEDULED_REPORTS_INTERVAL_MS=900000

# SMS (BulkSMS Namibia, bulksmsnam.com). 1 credit = 1 SMS, messages are limited to 160 characters. Nothing sends until the
# bulksmsnam arrangement is set active and the smsContactConfirmation capability is approved live in the ops console.
BULK_SMS_API_KEY=
# BULK_SMS_BASE_URL=https://bulksmsnam.com/api/v1

# SMS usage invoicing: invoices finished months of text messages (N$1.00 a text, see the SMS section of the blueprint). Opt-in. Safe to
# leave on: one invoice per organisation and month, and nothing is found to bill until texts have been sent.
SMS_USAGE_INVOICING_ENABLED=false
# SMS_USAGE_INVOICING_INTERVAL_MS=21600000

# Primary contact address (also used in user-facing messages). Defaults to hello@buffr.ai.
# PUBLIC_CONTACT_EMAIL=hello@buffr.ai
